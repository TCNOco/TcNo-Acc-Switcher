{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "minify:svg": "svgo --config svgo.config.mjs -r -f public/img"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.12",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "25.9.5",
    "sass": "1.102.0",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "svgo": "4.1.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
