[Desktop Entry]
Version=1.0
Name=TcNo Account Switcher
Comment=A Superfast open-source account switcher
Exec=/usr/local/bin/tcno-acc-switcher %u
Terminal=false
Type=Application
Icon=tcno-acc-switcher
Categories=Utility;Game;
Keywords=steam;account;switcher;
# Must equal the ProgramName passed to Wails (internal/app/gui.go): GTK4 has no
# way to set a window icon, so the desktop matches the window to this file by
# WM_CLASS and takes the icon from here.
StartupWMClass=tcno-acc-switcher
