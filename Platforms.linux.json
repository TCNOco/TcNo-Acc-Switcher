{
  "Platforms": {
    "Steam": {
      "Identifiers": [ "s", "steam", "valve" ],
      "ExeLocationDefault": [
        "%UserProfile%/.local/share/Steam/steam.sh",
        "%UserProfile%/.steam/steam/steam.sh",
        "%UserProfile%/.var/app/com.valvesoftware.Steam/.local/share/Steam/steam.sh"
      ],
      "ExesToEnd": [ "steam", "steamwebhelper" ],
      "PathListToClear": [ "SAME_AS_LOGIN_FILES" ],
      "LoginFiles": {
        "%Platform_Folder%/config/loginusers.vdf": "loginusers.vdf"
      },
      "AllFilesRequired": false,
      "ExitBeforeInteract": false,
      "UniqueIdFile": "%Platform_Folder%/config/loginusers.vdf",
      "UniqueIdMethod": "STEAM",
      "Extras": {
        "QuitArgs": "-shutdown",
        "BackupFolders": {
          "%Platform_Folder%/config": "config",
          "%Platform_Folder%/userdata": "userdata"
        },
        "BackupFileTypesInclude": [
          ".cfg",
          ".ini",
          ".dat",
          ".db",
          ".json",
          ".ProfileData",
          ".sav",
          ".save",
          ".nfo",
          ".txt",
          ".vcfg",
          ".vdf",
          ".vdf_last",
          ".vrmanifest",
          ".xml"
        ]
      }
    }
  },
  "Platform-WIP": {
  },
  "Version": "4.0.6"
}
